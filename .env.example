# Environment Variables for SapaDesa
# Salin file ini menjadi ".env" di folder yang sama, lalu isi nilainya.
# File .env TIDAK BOLEH di-commit ke Git (sudah masuk .gitignore).

# --- Database (dipakai docker-compose.yml & server) ---
DB_NAME=sapadesa
DB_USER=sapadesa_user
# GANTI dengan password BARU yang kuat. Password lama yang pernah tertulis
# di docker-compose.yml sudah terekspos di GitHub dan HARUS dianggap bocor.
DB_PASSWORD=
DB_ROOT_PASSWORD=

# --- Keamanan API ---
# Kunci untuk menandatangani token login. Buat yang acak & panjang, misal:
#   openssl rand -hex 32
AUTH_SECRET=

# --- Frontend ---
# URL Backend (Portainer/Produksi). Kosongkan bila satu origin dengan backend.
VITE_API_URL=https://sapadesa.rowosari.my.id/api
